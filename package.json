{
  "name": "@curvet/cli",
  "version": "0.3.0",
  "description": "Curvet in your terminal — chat, models, balance, and diagnostics for the Curvet Unified Playground API.",
  "type": "module",
  "bin": {
    "curvet": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "curvet",
    "ai",
    "cli",
    "llm",
    "chat",
    "image-generation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Curvet-in/curvet-cli.git"
  },
  "dependencies": {
    "@curvet/sdk": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
